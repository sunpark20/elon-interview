<%# Filter Bar %>
<section class="max-w-5xl mx-auto px-4 pt-8 pb-4">
  <%= form_with url: root_path, method: :get, local: true, class: "flex flex-wrap gap-3 items-center" do %>
    <div class="relative flex-1 min-w-[200px]">
      <input type="text" name="q" value="<%= params[:q] %>"
             placeholder="Search interviews..."
             class="w-full bg-gray-900 border border-gray-700 rounded-lg px-4 py-2 text-sm text-gray-200 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent">
    </div>

    <select name="year" onchange="this.form.submit()"
            class="bg-gray-900 border border-gray-700 rounded-lg px-3 py-2 text-sm text-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500">
      <option value="">All Years</option>
      <% @years.each do |year| %>
        <option value="<%= year %>" <%= 'selected' if params[:year].to_s == year.to_s %>><%= year %></option>
      <% end %>
    </select>

    <select name="interviewer" onchange="this.form.submit()"
            class="bg-gray-900 border border-gray-700 rounded-lg px-3 py-2 text-sm text-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500">
      <option value="">All Interviewers</option>
      <% @interviewers.each do |name| %>
        <option value="<%= name %>" <%= 'selected' if params[:interviewer] == name %>><%= name %></option>
      <% end %>
    </select>

    <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors">
      Search
    </button>

    <% if params[:q].present? || params[:year].present? || params[:interviewer].present? %>
      <%= link_to "Clear", root_path, class: "text-gray-400 hover:text-white text-sm transition-colors" %>
    <% end %>
  <% end %>
</section>

<%# Timeline %>
<section class="max-w-5xl mx-auto px-4 pb-20">
  <div class="relative">
    <%# Vertical center line %>
    <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-0.5 bg-gradient-to-b from-blue-500 via-purple-500 to-blue-500 md:-translate-x-px"></div>

    <% @grouped.each do |year, interviews| %>
      <%# Year marker %>
      <div class="relative flex items-center mb-8 mt-12 first:mt-0">
        <div class="absolute left-4 md:left-1/2 w-4 h-4 -translate-x-[7px] md:-translate-x-2 rounded-full bg-blue-500 ring-4 ring-gray-950 z-10"></div>
        <div class="ml-12 md:ml-0 md:absolute md:left-1/2 md:translate-x-6">
          <span class="text-2xl font-bold text-blue-400"><%= year || "Unknown" %></span>
        </div>
      </div>

      <% interviews.each_with_index do |interview, idx| %>
        <%# Alternate left/right on desktop %>
        <% right_side = idx.even? %>

        <div class="relative mb-8 flex items-start">
          <%# Dot on the line %>
          <div class="absolute left-4 md:left-1/2 w-3 h-3 -translate-x-[5px] md:-translate-x-1.5 mt-6 rounded-full bg-gray-400 ring-4 ring-gray-950 z-10 group-hover:bg-blue-400 transition-colors"></div>

          <%# Card %>
          <a href="<%= interview.youtube_url %>" target="_blank" rel="noopener noreferrer"
             class="group block ml-12 md:ml-0 md:w-[calc(50%-2rem)]
                    <%= right_side ? 'md:mr-auto md:pr-8' : 'md:ml-auto md:pl-8' %>
                    w-[calc(100%-3.5rem)]">
            <div class="bg-gray-900 border border-gray-800 rounded-xl p-5 hover:border-blue-500/50 hover:bg-gray-900/80 transition-all duration-300 hover:shadow-lg hover:shadow-blue-500/5">
              <%# Date and duration row %>
              <div class="flex items-center justify-between mb-2">
                <time class="text-xs font-medium text-blue-400">
                  <%= interview.interview_date&.strftime("%Y.%m.%d") || "날짜 미상" %>
                </time>
                <% if interview.duration && interview.duration > 0 %>
                  <span class="text-xs text-gray-500 bg-gray-800 px-2 py-0.5 rounded">
                    <%= interview.formatted_duration %>
                  </span>
                <% end %>
              </div>

              <%# Interviewer %>
              <div class="text-xs font-semibold text-purple-400 mb-1 uppercase tracking-wider">
                <%= interview.interviewer || interview.channel_name %>
              </div>

              <%# Title %>
              <h3 class="text-sm font-semibold text-gray-100 group-hover:text-white leading-snug mb-2 line-clamp-2">
                <%= interview.title %>
              </h3>

              <%# Summary %>
              <% if interview.summary.present? %>
                <p class="text-xs text-gray-400 leading-relaxed line-clamp-2">
                  <%= interview.summary %>
                </p>
              <% end %>

              <%# Thumbnail on hover (desktop only) %>
              <% if interview.thumbnail_url.present? %>
                <div class="hidden md:block mt-3 overflow-hidden rounded-lg opacity-0 max-h-0 group-hover:opacity-100 group-hover:max-h-40 transition-all duration-500">
                  <img src="<%= interview.thumbnail_url %>" alt="" class="w-full h-auto rounded-lg" loading="lazy">
                </div>
              <% end %>

              <%# Play icon hint %>
              <div class="flex items-center gap-1.5 mt-3 text-xs text-gray-500 group-hover:text-red-400 transition-colors">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z"/>
                </svg>
                <span>Watch on YouTube</span>
              </div>
            </div>
          </a>
        </div>
      <% end %>
    <% end %>

    <% if @grouped.empty? %>
      <div class="text-center py-20 text-gray-500">
        <p class="text-lg">No interviews found.</p>
        <% if params[:q].present? || params[:year].present? || params[:interviewer].present? %>
          <p class="mt-2"><%= link_to "Clear filters", root_path, class: "text-blue-400 hover:underline" %></p>
        <% end %>
      </div>
    <% end %>

    <%# Bottom cap %>
    <div class="relative flex items-center mt-8">
      <div class="absolute left-4 md:left-1/2 w-3 h-3 -translate-x-[5px] md:-translate-x-1.5 rounded-full bg-gray-600 ring-4 ring-gray-950"></div>
      <div class="ml-12 md:ml-0 md:absolute md:left-1/2 md:translate-x-6">
        <span class="text-sm text-gray-500 italic">More interviews coming soon...</span>
      </div>
    </div>
  </div>
</section>
